# Ordering Sensitive Assignments
# ==============================
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_clock_in.ip
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_reset_in.ip
set_global_assignment -name QSYS_FILE ../qsys/sws_niosv.qsys
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_intel_niosv_m_0.ip
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_onchip_memory2_0.ip
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_jtag_uart_0.ip
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_pio_0.ip
#set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_pio_1.ip
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_intel_lw_uart_0.ip
#set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_i2c_0.ip
set_location_assignment PIN_R5 -to i_rst_n -comment IOBANK_3A
set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_mm_bridge_0.ip
#set_global_assignment -name VHDL_FILE output_files/one_wire_module.vhd
#set_global_assignment -name IP_FILE ../qsys/ip/niosv2/niosv2_one_wire_module_1.ip
set_location_assignment PIN_AA7 -to io_one_wire -comment IOBANK_2A
set_global_assignment -name BOARD default
#set_global_assignment -name VHDL_FILE sim/tb_owreset.vhd
#set_global_assignment -name VHDL_FILE sim/tb_owread.vhd
#set_global_assignment -name VHDL_FILE sim/tb_owwrite.vhd
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to io_one_wire
set_instance_assignment -name SLEW_RATE 0 -to io_one_wire
set_instance_assignment -name IO_STANDARD "1.8-V" -to io_one_wire
set_instance_assignment -name IO_STANDARD "1.8-V" -to i_rst_n -entity sws_demo_top
set_instance_assignment -name IO_STANDARD "1.8-V" -to o_led
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to o_led
set_instance_assignment -name SLEW_RATE 0 -to o_led
set_location_assignment PIN_K4 -to o_led[1] -comment IOBANK_3A
set_location_assignment PIN_G3 -to o_led[2] -comment IOBANK_3A
set_location_assignment PIN_K5 -to o_led[3] -comment IOBANK_3A
set_location_assignment PIN_J3 -to o_led[0] -comment IOBANK_3A
set_location_assignment PIN_L3 -to i_clk_p -comment IOBANK_3A
set_instance_assignment -name IO_STANDARD LVDS -to i_clk_p
set_instance_assignment -name IO_STANDARD LVDS -to "i_clk_p(n)"
set_global_assignment -name IP_SEARCH_PATHS "../../../../ip/**/*; ../../../../lib/**/*"
set_global_assignment -name SDC_FILE  ../sdc/sws_demo.sdc
set_global_assignment -name SDC_FILE  ../sdc/jtag.sdc
set_global_assignment -name SIGNALTAP_FILE output_files/stp1.stp
set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name USE_SIGNALTAP_FILE output_files/sws_read_tap.stp
set_global_assignment -name SIGNALTAP_FILE stp1.stp
set_global_assignment -name SIGNALTAP_FILE sws_reset.stp
set_global_assignment -name SIGNALTAP_FILE sws_write.stp
set_global_assignment -name SIGNALTAP_FILE output_files/sws_write_tap.stp
set_global_assignment -name SIGNALTAP_FILE output_files/sws_read_tap.stp
